# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=True

# Comma-separated, e.g. localhost,127.0.0.1,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Your Neon connection string, e.g.:
# postgresql://user:password@host/dbname?sslmode=require
# Leave this line commented out to fall back to local sqlite (a blank value
# is NOT the same as unset and will fail — omit the line entirely instead).
# DATABASE_URL=

# Comma-separated origins allowed to call this API, e.g. restaurant-admin's Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Redis URL for the Channels layer (real-time POS/KDS/menu updates), e.g.:
# redis://localhost:6379/0
# Leave this line commented out (same rule as DATABASE_URL above) to fall
# back to an in-memory channel layer — fine for local `runserver`, useless
# across more than one worker process. Required for anything beyond local dev.
# REDIS_URL=

# ---------------------------------------------------------------------------
# Moyasar payment gateway
# ---------------------------------------------------------------------------
# Test vs live is ENTIRELY these keys — there is no mode flag in the code, so
# going live is a .env change and a restart, never a code change.
#   sandbox:    sk_test_… / pk_test_…
#   production: sk_live_… / pk_live_…
#
# MOYASAR_SECRET_KEY is backend-only. It is read in orders/moyasar.py and
# nowhere else, never serialized, never logged, and must never reach a browser.
MOYASAR_SECRET_KEY=

# Safe to expose. Returned by POST /api/bills/request-pay/ so the customer web
# app (burger_web) needs no Moyasar config of its own.
MOYASAR_PUBLISHABLE_KEY=

# Override only to point tests or a staging run at a stub.
# MOYASAR_API_BASE=https://api.moyasar.com/v1

# Optional shared secret. Set the same string here and on the webhook in the
# Moyasar dashboard, and the body's top-level `secret_token` field is compared
# with hmac.compare_digest before the webhook is accepted. Leave blank to skip
# that check — every webhook is re-verified against the Moyasar API either
# way, which is the real gate. Defence in depth, not the defence.
MOYASAR_WEBHOOK_SECRET=

# Public origin of the customer QR web app (burger_web). Used to build the
# Moyasar callback_url the customer is redirected back to after 3DS/STC Pay.
# Must be the real public origin in production — a localhost value here means
# customers are sent somewhere they cannot reach.
CUSTOMER_WEB_BASE_URL=http://localhost:3000
